// Optional: copy to Local.xcconfig to connect a build to your own services.
// These settings are public client values only. Never include server secrets.
SUPABASE_URL = https:/$()/YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY = REPLACE_WITH_PUBLIC_SUPABASE_PUBLISHABLE_KEY
API_BASE_URL = https:/$()/YOUR_API_HOST
REVENUECAT_PUBLIC_KEY = REPLACE_WITH_PUBLIC_TEST_STORE_SDK_KEY
WINGWARD_REVENUECAT_ENABLED = NO
WINGWARD_REVENUECAT_TEST_STORE = NO
WINGWARD_DEMO_JUDGE_MATCHING = NO
WINGWARD_RECORDING_REHEARSAL_MATCHING = NO
WINGWARD_NATIVE_VOICE_ENABLED = NO
WINGWARD_NATIVE_VOICE_BOOTSTRAP = openAIRealtime
