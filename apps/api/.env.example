# Server-only configuration for your own deployment. These are placeholders.
# For Wrangler development, copy this file to .dev.vars (which is ignored).
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=REPLACE_WITH_YOUR_SERVER_ONLY_SERVICE_ROLE_KEY
SUPABASE_ANON_KEY=REPLACE_WITH_YOUR_PUBLIC_SUPABASE_CLIENT_KEY
OPENAI_API_KEY=REPLACE_WITH_YOUR_SERVER_ONLY_OPENAI_KEY
MISTRAL_API_KEY=REPLACE_WITH_YOUR_SERVER_ONLY_MISTRAL_KEY
INTERNAL_API_TOKEN=REPLACE_WITH_YOUR_SERVER_ONLY_INTERNAL_TOKEN
REVENUECAT_WEBHOOK_SECRET=REPLACE_WITH_YOUR_SERVER_ONLY_WEBHOOK_SECRET
REVENUECAT_WEBHOOK_AUTHORIZATION=REPLACE_WITH_YOUR_SERVER_ONLY_WEBHOOK_AUTHORIZATION
BATCH_TIMEZONE=Asia/Tokyo

# Integrations and judging admission are closed until explicitly configured.
OPENAI_REALTIME_ENABLED=disabled
MEETUP_REFLECTION_REALTIME_ENABLED=disabled
MEETUP_REFLECTION_DRAFTS_ENABLED=disabled
CHAT_MEETUP_ENABLED=disabled
GOOGLE_CAFE_SEARCH_ENABLED=disabled
DEMO_JUDGE_ENABLED=disabled

# Optional adapters (leave blank when unused).
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID_JA=
ELEVENLABS_AGENT_ID_EN=
ELEVENLABS_VOICE_ID_JA=
ELEVENLABS_VOICE_ID_EN=
ELEVENLABS_MODEL_ID_JA=
ELEVENLABS_MODEL_ID_EN=
SPEED_DATING_AI_SERVER_ACTIVATION=disabled
ONESIGNAL_API_KEY=
ONESIGNAL_APP_ID=
PROFILE_PHOTO_STORAGE_ENABLED=disabled
PROFILE_PHOTO_STORAGE_PRIVATE=
PROFILE_PHOTO_STORAGE_BUCKET=
